    <script>
        let lastScrollTop = 0;
        const nav = document.querySelector('nav');

        window.addEventListener('scroll', function() {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

            if (scrollTop > lastScrollTop && scrollTop > 100) {
                nav.classList.add('hidden');
            } else {
                nav.classList.remove('hidden');
            }

            lastScrollTop = scrollTop;
        });

        // Modal functions
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('active');
            // Clear the form when opening
            const form = document.getElementById(modalId).querySelector('form');
            if (form) {
                form.reset();
            }
            // Clear any messages
            if (modalId === 'loginModal') {
                document.getElementById('loginMessage').innerHTML = '';
            } else if (modalId === 'registerModal') {
                document.getElementById('registerMessage').innerHTML = '';
            }
            // Reset validation states
            if (modalId === 'registerModal') {
                isNameValid = false;
                isEmailValid = false;
                isPasswordValid = false;
                isConfirmPasswordValid = false;
                document.querySelectorAll('.validation-message').forEach(el => {
                    el.innerHTML = '';
                    el.style.display = 'none';
                });
                document.querySelectorAll('.input-valid, .input-invalid').forEach(el => {
                    el.classList.remove('input-valid', 'input-invalid');
                });
            }
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
            // Clear validation signs when closing
            if (modalId === 'registerModal') {
                isNameValid = false;
                isEmailValid = false;
                isPasswordValid = false;
                isConfirmPasswordValid = false;
                document.querySelectorAll('.validation-message').forEach(el => {
                    el.innerHTML = '';
                    el.style.display = 'none';
                });
                document.querySelectorAll('.input-valid, .input-invalid').forEach(el => {
                    el.classList.remove('input-valid', 'input-invalid');
                });
            }
        }

        function switchModal(closeId, openId) {
            closeModal(closeId);
            openModal(openId);
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.classList.remove('active');
            }
        }

        // Show/hide clinic ID field based on role
        // Removed - clinic ID field no longer needed

        // Real-time validation for registration form
        const regName = document.getElementById('regName');
        const regEmail = document.getElementById('regEmail');
        const regPassword = document.getElementById('regPassword');
        const regConfirmPassword = document.getElementById('regConfirmPassword');
        const regRole = document.getElementById('regRole');
        const registerForm = document.getElementById('registerForm');

        let isNameValid = false;
        let isEmailValid = false;
        let isPasswordValid = false;
        let isConfirmPasswordValid = false;

        function showValidation(elementId, message, isValid) {
            const messageDiv = document.getElementById(elementId);
            const input = document.getElementById(elementId.replace('Message', ''));
            
            messageDiv.textContent = message;
            messageDiv.className = 'validation-message';
            
            if (isValid) {
                messageDiv.classList.add('valid');
                input.classList.remove('input-invalid');
                input.classList.add('input-valid');
            } else {
                messageDiv.classList.add('invalid');
                input.classList.remove('input-valid');
                input.classList.add('input-invalid');
            }
            
            if (message === '') {
                messageDiv.style.display = 'none';
                input.classList.remove('input-valid', 'input-invalid');
            }
        }

        function validateName() {
            const name = regName.value.trim();
            if (name.length === 0) {
                showValidation('nameMessage', '', false);
                isNameValid = false;
            } else if (name.length < 2) {
                showValidation('nameMessage', 'Name must be at least 2 characters', false);
                isNameValid = false;
            } else {
                showValidation('nameMessage', '✓ Valid', true);
                isNameValid = true;
            }
            checkFormValidity();
        }

        function validateEmail() {
            const email = regEmail.value.trim();
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            
            if (email.length === 0) {
                showValidation('emailMessage', '', false);
                isEmailValid = false;
            } else if (!emailRegex.test(email)) {
                showValidation('emailMessage', 'Invalid email format', false);
                isEmailValid = false;
            } else {
                // Check if email already exists in database
                fetch('login/check_email.php', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: 'email=' + encodeURIComponent(email)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.exists) {
                        showValidation('emailMessage', 'Email already registered', false);
                        isEmailValid = false;
                    } else {
                        showValidation('emailMessage', '✓ Valid', true);
                        isEmailValid = true;
                    }
                    checkFormValidity();
                })
                .catch(error => {
                    showValidation('emailMessage', '✓ Valid', true);
                    isEmailValid = true;
                    checkFormValidity();
                });
            }
            checkFormValidity();
        }

        function validatePassword() {
            const password = regPassword.value;
            if (password.length === 0) {
                showValidation('passwordMessage', '', false);
                isPasswordValid = false;
            } else if (password.length < 6) {
                showValidation('passwordMessage', 'Password must be at least 6 characters', false);
                isPasswordValid = false;
            } else {
                showValidation('passwordMessage', '✓ Valid', true);
                isPasswordValid = true;
            }
            // Re-validate confirm password
            validateConfirmPassword();
            checkFormValidity();
        }

        function validateConfirmPassword() {
            const password = regPassword.value;
            const confirmPassword = regConfirmPassword.value;
            
            if (confirmPassword.length === 0) {
                showValidation('confirmPasswordMessage', '', false);
                isConfirmPasswordValid = false;
            } else if (password !== confirmPassword) {
                showValidation('confirmPasswordMessage', 'Passwords do not match', false);
                isConfirmPasswordValid = false;
            } else {
                showValidation('confirmPasswordMessage', '✓ Valid', true);
                isConfirmPasswordValid = true;
            }
            checkFormValidity();
        }

        function checkFormValidity() {
            // Removed button disabling - button should always be clickable
            // Validation errors will be shown, but user can still submit
        }

        // Add event listeners
        regName.addEventListener('input', validateName);
        regName.addEventListener('blur', validateName);
        
        regEmail.addEventListener('input', function() {
            // Debounce email validation
            clearTimeout(window.emailTimeout);
            window.emailTimeout = setTimeout(validateEmail, 500);
        });
        regEmail.addEventListener('blur', validateEmail);
        
        regPassword.addEventListener('input', validatePassword);
        regPassword.addEventListener('blur', validatePassword);
        
        regConfirmPassword.addEventListener('input', validateConfirmPassword);
        regConfirmPassword.addEventListener('blur', validateConfirmPassword);

        // Handle register form submission with AJAX
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            
            fetch('login/register.php', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(response => response.text())
            .then(data => {
                // Check if response contains success message
                if (data.includes('Registration successful')) {
                    document.getElementById('registerMessage').innerHTML = '<div class="message success">Registration successful! Please login.</div>';
                    this.reset();
                    setTimeout(() => {
                        closeModal('registerModal');
                        openModal('loginModal');
                    }, 1500);
                } else {
                    // Show error message from the response
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(data, 'text/html');
                    const messageDiv = doc.querySelector('.message');
                    if (messageDiv) {
                        document.getElementById('registerMessage').innerHTML = messageDiv.outerHTML;
                    } else {
                        document.getElementById('registerMessage').innerHTML = '<div class="message error">Registration failed. Please try again.</div>';
                    }
                }
            })
            .catch(error => {
                document.getElementById('registerMessage').innerHTML = '<div class="message error">Registration failed. Please try again.</div>';
            });
        });
    </script>
</body>
</html>
